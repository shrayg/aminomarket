generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  desc     String?
  products Product[]
}

model Product {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  price      Float
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id])
  inStock    Boolean     @default(true)
  isFeatured Boolean     @default(false)
  isPreSale  Boolean     @default(false)
  orderItems OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  email     String
  total     Float
  status    String      @default("pending")
  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AnalyticsSession {
  id              String           @id
  visitorId       String?
  entryPath       String
  source          String?
  referrer        String?
  startedAt       DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  durationSeconds Int              @default(0)
  engaged         Boolean          @default(false)
  pageViews       Int              @default(0)
  checkoutStarted Boolean          @default(false)
  converted       Boolean          @default(false)
  events          AnalyticsEvent[]

  @@index([startedAt])
}

model AnalyticsEvent {
  id              String           @id @default(cuid())
  sessionId       String
  session         AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  visitorId       String?
  type            String
  path            String?
  productSlug     String?
  query           String?
  source          String?
  referrer        String?
  value           Float?
  durationSeconds Int              @default(0)
  metadata        Json?
  createdAt       DateTime         @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
}

model FulfillmentRecord {
  stripeSessionId String   @id
  status          String   @default("unfulfilled")
  trackingNumber  String?
  note            String?
  updatedAt       DateTime @updatedAt
}
